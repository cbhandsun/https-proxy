{
  "activeProfile": "example-openai",
  "appSettings": {
    "autoStartProxy": true,
    "closeToTray": true,
    "showTopMenu": true,
    "showTrayMenu": true,
    "showWindowOnTrayCommand": true,
    "stopProxyOnExit": true,
    "disableLocalProxy": false,
    "verifyUpstreamTls": true,
    "conversationAuditEnabled": true,
    "forceResponseStreaming": false,
    "responseStreamingRolloutPercent": 0,
    "forceChatStreaming": false,
    "upstreamWarmupEnabled": false,
    "upstreamWarmupIntervalMs": 45000,
    "upstreamWarmupMaxTargets": 4,
    "upstreamWarmupStaggerMs": 200,
    "streamDirectRequestBodies": false
  },
  "entryAuth": {
    "enabled": true,
    "keys": [],
    "allowedOrigins": []
  },
  "diagnostics": {
    "captureGemini": true,
    "captureOpenAI": false,
    "captureOutboundSse": true,
    "captureRequestToolResults": true,
    "enabled": false,
    "externalIngressTimeoutMs": 5000,
    "externalIngressUrl": "",
    "maxFileBytes": 5242880,
    "maxTextBytes": 12000
  },
  "entryServers": [
    {
      "basePath": "/v1",
      "enabled": true,
      "host": "localhost",
      "listenPort": 3443,
      "name": "Claude Messages",
      "protocol": "claude"
    },
    {
      "basePath": "/v1",
      "enabled": true,
      "host": "localhost",
      "listenPort": 3445,
      "name": "OpenAI Responses",
      "protocol": "openai-responses"
    },
    {
      "basePath": "/v1",
      "enabled": true,
      "host": "localhost",
      "listenPort": 3447,
      "name": "OpenAI Chat Completions",
      "protocol": "openai-chat"
    },
    {
      "basePath": "/v1",
      "enabled": true,
      "host": "localhost",
      "listenPort": 3080,
      "name": "Claude Messages HTTP",
      "protocol": "claude",
      "tls": false
    },
    {
      "basePath": "/v1",
      "enabled": true,
      "host": "localhost",
      "listenPort": 3082,
      "name": "OpenAI Responses HTTP",
      "protocol": "openai-responses",
      "tls": false
    },
    {
      "basePath": "/v1",
      "enabled": true,
      "host": "localhost",
      "listenPort": 3084,
      "name": "OpenAI Chat Completions HTTP",
      "protocol": "openai-chat",
      "tls": false
    }
  ],
  "claudeDesktop": {
    "baseUrl": "https://localhost:3443",
    "enabled": false,
    "mode": "proxy",
    "models": [
      {
        "labelOverride": "GPT-5.4",
        "profileId": "example-openai",
        "routeId": "claude-sonnet-4-6",
        "supports1m": true,
        "upstreamModel": "gpt-5.4"
      }
    ],
    "profileName": "HTTPS Proxy",
    "token": ""
  },
  "localServer": {
    "basePath": "/v1",
    "host": "localhost",
    "listenPort": 3443,
    "protocol": "claude"
  },
  "modelRoutes": [
    {
      "from": "default",
      "profileId": "example-openai",
      "to": "gpt-5.4"
    },
    {
      "from": "gpt-5.6-sol",
      "profileId": "example-openai",
      "to": "gpt-5.6-sol"
    },
    {
      "from": "gpt-5.6-terra",
      "profileId": "example-openai",
      "to": "gpt-5.6-terra"
    },
    {
      "from": "gpt-5.6-luna",
      "profileId": "example-openai",
      "to": "gpt-5.6-luna"
    }
  ],
  "profiles": [
    {
