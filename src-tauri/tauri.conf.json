{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HTTPS Proxy Manager",
  "version": "0.1.0",
  "identifier": "com.efficiency.https-proxy-manager",
  "build": {
    "frontendDist": "../tauri-ui/dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run frontend:dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run frontend:build && npm run release:prepare"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HTTPS Proxy Manager",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https://127.0.0.1:* https://localhost:* tauri://localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../openai-proxy.js": "openai-proxy.js",
      "../proxy.bat": "proxy.bat",
      "../proxy.ps1": "proxy.ps1",
      "../proxy.config.example.json": "proxy.config.example.json",
      "../dist/release-runtime/package.json": "package.json",
      "../lib": "lib",
      "../dist/release-runtime/node_modules": "node_modules",
      "../dist/release-runtime/runtime": "runtime",
      "../dist/release-runtime/release-runtime-manifest.json": "release-runtime-manifest.json"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  }
}
