{
  "name": "https-proxy-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "npm run frontend:sync",
    "start": "node openai-proxy.js",
    "test": "npm run frontend:check && npm run test:unit && npm run test:thinking && npm run test:env",
    "test:unit": "node test/adapter.test.js",
    "test:thinking": "node test/thinking-persistence.test.js",
    "test:env": "node test/env-tools.test.js && node test/tool-configs.test.js",
    "test:integration": "node test/headers-routing.test.js",
    "test:all": "npm test && npm run test:integration",
    "check:syntax": "node scripts/check-syntax.js",
    "verify": "npm run check:syntax && npm run test:all",
    "frontend:sync": "node scripts/sync-frontend.js",
    "frontend:check": "node scripts/sync-frontend.js --check",
    "dev": "npx tauri dev",
    "build": "npx tauri build",
    "tauri:dev": "npx tauri dev",
    "tauri:build": "npx tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0"
  },
  "dependencies": {
    "node-forge": "^1.4.0"
  }
}
