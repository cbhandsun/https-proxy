{
  "name": "https-proxy-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "npm run frontend:sync",
    "start": "node openai-proxy.js",
    "test": "npm run frontend:check && npm run test:unit && npm run test:frontend && npm run test:thinking && npm run test:env",
    "test:unit": "node scripts/run-unit-test-shards.js",
    "test:unit:serial": "node scripts/run-unit-tests.js",
    "test:frontend": "node tauri-ui/src/utils.test.js",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:thinking": "node test/thinking-persistence.test.js",
    "test:env": "node test/env-tools.test.js && node test/tool-configs.test.js",
    "test:integration": "node test/headers-routing.test.js && node test/entry-auth-integration.test.js",
    "test:all": "npm test && npm run test:integration",
    "check:syntax": "node scripts/check-syntax-parallel.js",
    "verify": "npm run check:syntax && npm run lint && npm run release:check && npm run test:all && npm run frontend:build && npm run release:prepare && npm run test:rust",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,cjs,mjs,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,json,md}\" --ignore-path .prettierignore",
    "prepare": "husky",
    "frontend:sync": "node scripts/sync-frontend.js",
    "frontend:check": "node scripts/sync-frontend.js --check",
    "frontend:dev": "vite",
    "frontend:build": "vite build",
    "frontend:preview": "vite preview",
    "cert:trust:gateway": "node scripts/install-gateway-ca.js",
    "dev": "npm run frontend:check && npx tauri dev",
    "build": "npm run tauri:build",
    "tauri:dev": "npm run frontend:check && npx tauri dev",
    "tauri:build": "node scripts/build-tauri-release.js",
    "clean:release": "node scripts/clean-release-artifacts.js",
    "clean:release:cache": "node scripts/clean-release-artifacts.js --cargo-only",
    "release:prepare": "node scripts/prepare-release-runtime.js",
    "release:check": "node scripts/check-release-governance.js",
    "release:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "eslint": "^9.39.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "vite": "^6.4.3"
  },
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "node-forge": "^1.4.0",
    "pino": "^10.3.1",
    "socks-proxy-agent": "^10.0.0"
  }
}
