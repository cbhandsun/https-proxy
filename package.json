{
  "name": "https-proxy-manager",
  "version": "0.1.0",
  "private": true,
  "hpm": {
    "releaseRuntimeDependencies": [
      "node-forge",
      "pino",
      "safe-regex2",
      "socks-proxy-agent"
    ]
  },
  "scripts": {
    "start": "node openai-proxy.js",
    "test": "npm run test:unit && npm run test:frontend && npm run test:thinking && npm run test:env",
    "test:unit": "node scripts/run-unit-test-shards.js",
    "test:unit:serial": "node scripts/run-unit-tests.js",
    "test:coverage": "c8 --clean --all --include \"lib/proxy/**/*.js\" --exclude \"lib/proxy/trae-*.js\" --exclude \"lib/proxy/handlers.js\" --reporter=json --reporter=text-summary --check-coverage --statements 58 --branches 65 --functions 62 --lines 58 node scripts/run-unit-tests.js && node scripts/check-security-coverage.js",
    "test:frontend": "node scripts/run-frontend-tests.js",
    "test:rust": "npm run release:prepare && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:thinking": "node test/thinking-persistence.test.js",
    "test:env": "node test/env-tools.test.js && node test/tool-configs.test.js",
    "test:integration": "node test/headers-routing.test.js && node test/entry-auth-integration.test.js",
    "test:all": "npm test && npm run test:integration",
    "check:syntax": "node scripts/check-syntax-parallel.js",
    "check:architecture": "node test/frontend/frontend-build-governance.test.js",
    "check:ci": "node scripts/check-ci-governance.js",
    "verify": "npm run format:check && npm run check:syntax && npm run lint && npm run check:ci && npm run release:check && npm run test:coverage && npm run test:frontend && npm run test:thinking && npm run test:env && npm run test:integration && npm run frontend:build && npm run test:rust",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,cjs,mjs,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,json,md}\" --ignore-path .prettierignore",
    "prepare": "husky",
    "frontend:dev": "vite",
    "frontend:build": "npm run check:architecture && npm run clean:frontend && vite build",
    "frontend:preview": "vite preview",
    "cert:trust:gateway": "node scripts/install-gateway-ca.js",
    "dev": "npx tauri dev",
    "build": "npm run tauri:build",
    "tauri:dev": "npx tauri dev",
    "tauri:build": "node scripts/build-tauri-release.js",
    "clean:frontend": "node scripts/clean-generated-artifacts.js --frontend-only",
    "clean:coverage": "node scripts/clean-generated-artifacts.js --coverage-only",
    "clean:test-runtime": "node scripts/clean-generated-artifacts.js --test-only",
    "clean:staging": "node scripts/clean-generated-artifacts.js --staging-only",
    "clean:artifacts": "node scripts/clean-generated-artifacts.js --artifacts-only",
    "clean:release": "node scripts/clean-generated-artifacts.js",
    "clean:release:cache": "node scripts/clean-generated-artifacts.js --cargo-only",
    "release:prepare": "node scripts/prepare-release-runtime.js",
    "release:check": "node scripts/check-release-governance.js",
    "release:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.2",
    "c8": "^12.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "vite": "^6.4.3"
  },
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "node-forge": "^1.4.0",
    "pino": "^10.3.1",
    "safe-regex2": "^5.1.1",
    "socks-proxy-agent": "^10.0.0"
  }
}
